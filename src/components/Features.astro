---
// 產品能力：三個核心能力搭配實際畫面特寫，其餘能力收成短清單
// 原「為什麼選 JOULARIS」的穩定性與擴充性併入此處與導入流程
import ShotCrop from './ShotCrop.astro';
import emsDashboard from '../assets/ems-dashboard.png';
import logicflowHvac from '../assets/logicflow-hvac-v5.png';
import enpiReport from '../assets/enpi-report.png';

const core = [
  {
    title: '需量快超約之前，先通知你',
    desc: '逼近契約容量就先警告，不讓超約附加費出現在帳單上。電費、水費、氣費每期自動結算，不必再派人逐張對帳。',
    src: emsDashboard,
    box: [14, 257, 644, 318] as [number, number, number, number],
    small: true,
    alt: '今日即時需量畫面：目前 825 kW，今日最高需量 918.4 kW（11:20）',
    caption: '今日即時需量：目前值與今日最高需量隨時看得到',
  },
  {
    title: '空調自己調，不用派人守著',
    desc: '系統依室內外溫度和主機用電，自動調整泵浦轉速，開關機交給排程。不必排人整天守在中控室，也不會因為忘了關而讓設備空轉一整晚。',
    src: logicflowHvac,
    box: [0, 67, 2000, 1183] as [number, number, number, number],
    alt: '空調最佳化流程圖：室內外溫度與用電數據輸入，輸出冰水泵 46.5 Hz、冷卻水泵 42 Hz',
    caption: '空調最佳化流程：溫度與用電進，泵浦頻率出',
  },
  {
    title: 'ISO 50001 要的數據，系統自己彙整',
    desc: '能源基線、績效指標和查核紀錄都由系統整理好。稽核或政府能源申報前，不必再找人加班翻資料、拼報表。',
    src: enpiReport,
    base: [1499, 949] as [number, number],
    box: [0, 46, 1499, 903] as [number, number, number, number],
    alt: 'ISO 50001 節能量報告：逐月實際能耗與基線預測的長條圖，以及累計節能量曲線',
    caption: '節能量報告：實際用電對照基線預測，累計節能量逐月累加',
  },
];

const more = [
  {
    title: '電、水、氣三表整合',
    desc: '三種能源的即時用量與歷史趨勢放在同一套系統，不用分別登入查數據。',
  },
  {
    title: '異常即時通知',
    desc: '設備一出狀況，負責人手機馬上收到 LINE 或簡訊，小問題不會拖成停機。',
  },
  {
    title: '每日能源日報',
    desc: '每天早上寄到信箱，主管一眼看完昨天的用電和異常，不用另外開會報告。',
  },
  {
    title: '7×24 穩定運轉',
    desc: '系統全天運轉，斷線會自動補接，夜間和假日不必留人看數據。',
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <h2>每天幫你盯著的三件事</h2>
      <p>下面都是系統的實際畫面。</p>
    </div>

    <div class="core-list">
      {
        core.map((c, i) => (
          <article class:list={['core', { flip: i % 2 === 1 }]}>
            <div class="core-copy">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
            <figure class:list={['core-shot', { small: c.small }]}>
              <ShotCrop src={c.src} base={c.base} box={c.box} alt={c.alt} />
              <figcaption>{c.caption}</figcaption>
            </figure>
          </article>
        ))
      }
    </div>

    <div class="more">
      <h3 class="more-head">其他也都在裡面</h3>
      <dl class="more-list">
        {
          more.map((m) => (
            <div class="more-item">
              <dt>{m.title}</dt>
              <dd>{m.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="inline-cta">
      想看這些畫面接上你的電表會是什麼樣子？<a href="#contact">預約產品展示</a>
    </p>
  </div>
</section>

<style>
  .core-list {
    display: grid;
    gap: 88px;
  }

  .core {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 56px;
    align-items: center;
  }

  .core.flip {
    grid-template-columns: 7fr 5fr;
  }

  .core.flip .core-copy {
    order: 2;
  }

  .core-copy h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.35;
    margin-bottom: 0.6em;
    word-break: keep-all;
  }

  .core-copy p {
    margin: 0;
    max-width: 34em;
  }

  .core-shot {
    margin: 0;
  }

  .core-shot.small {
    width: 72%;
    justify-self: center;
  }

  .core-shot :global(.shot-crop) {
    box-shadow: 0 6px 16px rgb(16 46 40 / 0.1);
  }

  .core-shot figcaption {
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  /* ---- 其他能力：不用卡片，以細線分隔的清單呈現 ---- */

  .more {
    margin-top: 96px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
  }

  .more-head {
    font-size: 1.1rem;
    margin: 0;
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 40px;
    margin: 0;
  }

  .more-item dt {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .more-item dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .core-list {
      gap: 56px;
    }

    .core,
    .core.flip {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .core.flip .core-copy {
      order: 0;
    }

    .core-shot.small {
      width: 100%;
    }

    .more {
      margin-top: 64px;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .more-list {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
